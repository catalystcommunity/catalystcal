# Local development settings for the catalystcal API.
#
# Copy this file to .env.dev:   cp .env.dev.example .env.dev
# `./tools dev` and `./tools run-api` read .env.dev. git ignores .env.dev.
# The values here are for one workstation only. Do not use them in
# production.

# ---- Mode -------------------------------------------------------------
# dev | nonprod | prod. The dev sign-in page works only when CATALYSTCAL_ENV is
# dev or nonprod AND CATALYSTCAL_DEV_AUTH_ENABLED is true.
CATALYSTCAL_ENV=dev
CATALYSTCAL_DEV_AUTH_ENABLED=true

# ---- Ports ------------------------------------------------------------
# API (CSIL-RPC, sign-in start, iCalendar feeds).
CATALYSTCAL_API_PORT=7080
# Ops server: /healthz (liveness) and /readyz (readiness).
CATALYSTCAL_OPS_PORT=7081

# ---- Storage ----------------------------------------------------------
# SQLite file. `./tools dev` runs the API from the repo root, so this path
# is relative to the repo root. git ignores .data/.
CATALYSTCAL_DB_PATH=./.data/catalystcal.db

# ---- Tokens -----------------------------------------------------------
# Signs session and bearer tokens. Any value works in dev. In prod, use
# 32 bytes or more of random data:  openssl rand -base64 48
CATALYSTCAL_JWT_SECRET=dev-only-jwt-secret-change-me-not-for-prod
CATALYSTCAL_BEARER_TTL_SECONDS=3600
CATALYSTCAL_SESSION_TTL_HOURS=720

# ---- URLs -------------------------------------------------------------
# The URL people use to open catalystcal. The Vite dev server is on 5180 and
# proxies /api and /ics to the API.
CATALYSTCAL_PUBLIC_URL=http://localhost:5180
# The SPA route that LinkKeys sends people back to after sign-in.
CATALYSTCAL_CALLBACK_URL=http://localhost:5180/auth/callback

# ---- Who can sign in ----------------------------------------------------
# Comma-separated lists. Leave both empty in dev. In prod, set one or both
# to limit sign-in to known LinkKeys domains or accounts.
CATALYSTCAL_ALLOWED_DOMAINS=
CATALYSTCAL_ALLOWED_USERS=

# ---- Trash -------------------------------------------------------------
# How long a deleted event stays restorable (days, 1 to 365).
# CATALYSTCAL_TRASH_RETENTION_DAYS=30

# ---- Calendar subscriptions ---------------------------------------------
# How often catalystcal fetches subscribed external calendars (minutes).
CATALYSTCAL_SUBSCRIPTION_REFRESH_MINUTES=60
# Let subscriptions fetch private network addresses (for example a
# calendar server on your LAN). Keep false in prod: true lets a user make
# the server fetch internal addresses.
CATALYSTCAL_SUBSCRIPTION_ALLOW_PRIVATE=false

# ---- LinkKeys (real sign-in) --------------------------------------------
# Not necessary for local development: use the dev sign-in page. To test the
# real LinkKeys flow, set these to a LinkKeys IDP and a relying party (RP)
# that knows this catalystcal instance. See docs/deploy.md.
#
# CATALYSTCAL_LINKKEYS_IDP_DOMAIN=example.com
# CATALYSTCAL_LINKKEYS_IDP_URL=https://linkkeys.example.com
# CATALYSTCAL_LINKKEYS_RP_DOMAIN=catalystcal.example.com
# The application ID in each sign-in request. Empty: the act-as key file
# application ID, else the RP account username.
# CATALYSTCAL_LINKKEYS_APPLICATION_ID=catalystcal
# CATALYSTCAL_LINKKEYS_PKI_API_KEY=<secret>
#
# The RP CSIL-RPC/TCP endpoint. Empty: DNS discovery from the IDP domain.
# CATALYSTCAL_LINKKEYS_TCP_ADDR=linkkeys.example.com:4987
# CATALYSTCAL_LINKKEYS_TCP_FINGERPRINTS=<sha256-hex>,<sha256-hex>
# CATALYSTCAL_LINKKEYS_TCP_ALLOW_INSECURE=false

# ---- Act-as (delegations through LinkKeys application keys) ----------------
# Optional. A JSON file with the catalystcal LinkKeys application identity and its
# Ed25519 signing key seeds. This file is a secret. Keep it out of git.
# CATALYSTCAL_ACT_AS_APP_KEYS_FILE=./.data/act-as-app-keys.json
# The oldest act-as presentation (in seconds) that catalystcal accepts. Leave
# unset to use the API default.
# CATALYSTCAL_ACT_AS_MAX_PRESENTATION_AGE_SECONDS=
# The LinkKeys TCP server of the home domain of the application account. The
# API renews its key attestations there. Default: the RP TCP values.
# CATALYSTCAL_ACT_AS_HOME_TCP_ADDR=
# CATALYSTCAL_ACT_AS_HOME_TCP_FINGERPRINTS=

# ---- Application principals ------------------------------------------------
# Optional. Needs CATALYSTCAL_ACT_AS_APP_KEYS_FILE: the file names this
# server's own application identity (the presentation audience).
# Applications that may sign in as themselves, comma-separated, each as
# <subject_user_id>@<domain>/<application_id>. These are public identities.
# CATALYSTCAL_ALLOWED_APPLICATIONS=
# The oldest application presentation accepted (1 to 900). Default 300.
# CATALYSTCAL_APP_PRESENTATION_MAX_AGE_SECONDS=
# The life of an application bearer (1 to 3600). Default 900.
# CATALYSTCAL_APP_BEARER_TTL_SECONDS=
