# catalystcal web tier. Caddy serves the built SPA and proxies the API paths.
#
# Environment:
#   CATALYSTCAL_WEB_PORT      port to listen on (default 8080)
#   CATALYSTCAL_API_UPSTREAM  host:port of the catalystcal API (default api:7080)
#
# No TLS here. A Gateway, an Ingress, or another proxy in front of this
# container terminates HTTPS. In Kubernetes the Gateway can also send /api
# and /ics directly to the API Service; this proxy then gets no such
# requests, and it does no harm.

{
	auto_https off
	admin off
	persist_config off
}

:{$CATALYSTCAL_WEB_PORT:8080} {
	root * /usr/share/caddy
	encode zstd gzip

	# Security headers for every response, proxied or static.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The SPA loads only its own scripts. Inline styles are allowed
		# because UI libraries set style attributes. If the SPA needs a
		# new origin, add it here.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# `handle` blocks are mutually exclusive: exactly one runs for each
	# request. Order of specificity decides the match.

	# Liveness and readiness probe for this container.
	handle /healthz {
		respond "ok" 200
	}

	# The API: CSIL-RPC, the sign-in start, and the health route.
	handle /api/* {
		reverse_proxy {$CATALYSTCAL_API_UPSTREAM:api:7080}
	}

	# Public iCalendar feeds. Apple, Google, and Outlook fetch these
	# from the public hostname, so they must not need a session.
	handle /ics/* {
		reverse_proxy {$CATALYSTCAL_API_UPSTREAM:api:7080}
	}

	# Vite puts hashed file names under /assets/. A changed file gets a
	# new name, so a long cache is safe.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: serve the file if it exists. If not, serve
	# /index.html so the SPA router can take the path (for example
	# /auth/callback). These responses must revalidate, so that a new
	# release loads on the next page view. Do not use a path matcher on
	# the header here: `header` runs before `try_files`, so it sees the
	# original path (/auth/callback), not /index.html.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
