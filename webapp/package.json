{
  "name": "catalystcal-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "catalystcal calendar web UI: Zest web components + Vite + CSIL-RPC",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest"
  },
  "dependencies": {
    "@catalystcommunity/actions": "0.1.2",
    "@catalystcommunity/base-components": "0.2.7",
    "@catalystcommunity/basic-data-service": "0.2.7",
    "@catalystcommunity/calendar-view": "0.1.2",
    "@catalystcommunity/containers": "0.1.3",
    "@catalystcommunity/controls": "0.1.2",
    "@catalystcommunity/date-time-picker": "0.2.8",
    "@catalystcommunity/design-tokens": "0.1.2",
    "@catalystcommunity/menus": "0.1.2",
    "@catalystcommunity/simple-router": "0.3.2",
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource-variable/schibsted-grotesk": "5.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "25.9.1",
    "happy-dom": "20.9.0",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "4.1.6"
  }
}
